# sdkconfig.defaults —— ESP32-S3-EYE 板级默认配置
# 用 `idf.py set-target esp32s3` 后，这些配置会自动合并进 sdkconfig。

# 【关键】控制台走 USB Serial/JTAG，也就是你看到的 COM4。
# 这块板没有独立的 USB 转 UART 芯片，若不设这一项，串口监视器将看不到任何日志。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 板载 8 MB flash（ESP32-S3-WROOM-1-N8R8），按实际硬件设置
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# 主任务栈增大到 8 KB：app_main 里同时用到 cJSON 组装、HTTP 上传、SNTP，
# 默认的 3.5 KB 偏紧，增大可避免栈溢出导致的莫名重启。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# 使用 -O2 而非默认的 -Og 优化等级。
# 原因：ESP-IDF v5.5.5 + GCC 14.2.0 在 -Og 模式下编译 esp_lcd/rgb/esp_lcd_panel_rgb.c
# 会触发 GCC 自身的 RTL pass bug（内部段错误）。该驱动仅用于 RGB LCD 屏幕，
# ESP32-S3-EYE 板载 SPI 小屏（不需要 RGB 驱动），但 IDF 默认仍会编译它。
# 切到 -O2 后该文件可正常编译，不影响功能。
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 本固件需要摄像头时，必须开启 PSRAM 作为帧缓冲；ESP32-S3-EYE(N8R8) 板载 8MB PSRAM。
CONFIG_SPIRAM=y
# ESP32-S3-EYE(N8R8) 板载 Octal(8线) PSRAM，必须选 OCT 模式；
# 误选 QUAD 会在启动时报 "wrong PSRAM line mode" 并 abort。
CONFIG_SPIRAM_MODE_OCT=y

# 让 SCCB 走硬件 I2C，并**显式指定 I2C 端口 0**（与板载 QMA7981 共用 GPIO4-5）。
# 否则 esp32-camera 默认用软件 bit-bang SCCB，初始化时把 GPIO4/5 重配为普通 GPIO，
# 覆盖 QMA7981 的硬件 I2C 配置，导致加速度计后续读取失败。
#
# 【坑】esp32-camera 的这两个选项名是 CONFIG_SCCB_*，**不是** CONFIG_CAMERA_SCCB_*；
#      端口默认值是 PORT1，必须显式改成 PORT0，否则会在端口 1 上另建一条总线却仍用 GPIO4/5，
#      与 QMA7981（端口 0）抢同一对物理线，导致两类数据全部停传。
#      （历史上这里曾误写为不存在的 CONFIG_CAMERA_SCCB_USE_I2C=y，该行会被静默忽略、完全空转。）
#      代码侧另有第二道保险：camera.c 里把 pin_sscb_sda/scl 设为 -1、
#      并指定 .sccb_i2c_port = I2C_NUM_0，直接复用加速度计已建好的那条总线。
CONFIG_SCCB_HARDWARE_I2C_DRIVER_NEW=y
CONFIG_SCCB_HARDWARE_I2C_PORT0=y

# 应用体积变大（esp32-camera 较大），原默认 1MB app 分区装不下，
# 改用自定义分区表（factory 3MB），分区定义见 partitions.csv。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 【排障记录 · 已回退】曾尝试关闭 A-MPDU 聚合（Block-ACK）来绕开
# 「AP 反复建/拆 BA 会话导致数据帧发不出去」的怀疑：
#     CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
#     CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
# 实测结果：**无效**。关闭后上传依旧大面积失败（50 秒 0 成功），
# 说明根因不在聚合层，已恢复 IDF 默认值。
# 保留这段记录，是为了避免以后重复做同一个无效实验。
#
# 当时观察到的现象（供以后参考）：
#   - 串口：I wifi:<ba-add>idx:1 (ifx:0, ...), tid:0 ... 紧接着 I wifi:<ba-del>idx:1, tid:0
#   - 板子：select() timeout / Connection timed out before data was ready
#   - 电脑：netstat 有 ESTABLISHED，但服务端日志无任何请求（数据没送达）

# ---------------------------------------------------------------------------
# 【关键】lwIP 连接资源上限 —— 治"高频短连接把 PCB 耗光"
#
# 症状：板子跑约 10~20 秒后开始大面积上报失败，串口出现
#         W transport_base: Poll timeout or error,
#           errno=Connection already in progress, fd=54, timeout_ms=8000
#         E transport_base: tcp_read error, errno=Connection reset by peer
#         E app: 上传失败 / 帧上传失败 / 取指令失败（连续失败次数不断累加）
#       复位后前 10 秒左右正常，随后又复发。
#
# 原因：本固件每次上报都新建一条 TCP 连接，没有复用。
#       POST /api/ingest 每 1 秒、POST /api/frame 每 2 秒、GET /api/command/poll 每 5 秒，
#       合计约 1.7 条/秒。连接关闭后 PCB 还要在 TIME_WAIT / FIN_WAIT 里滞留一段时间，
#       而 IDF 默认上限只有 10 个 socket、16 条活动 TCP，FIN_WAIT 要等 20 秒，
#       于是不到 20 秒就把 PCB 用光，之后**所有**新连接一律失败。
#
#       （第 1 周记录的"98% 请求失败率"很可能就是同一个根因，
#         当时误判为校园网 AP 隔离 —— 那条 A-MPDU 实验之所以无效，
#         也是因为它根本没碰到连接资源这一层。）
#
# 处理：放宽上限 + 缩短滞留时间，让"用完即回收"跟得上"每秒新建"。
#       48 条 PCB 约多占 12 KB RAM，ESP32-S3 完全放得下。
#
# 【注意】sdkconfig 已存在时会覆盖 sdkconfig.defaults，改完这里
#         要么一并改 sdkconfig，要么删掉 sdkconfig 重新生成。
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_MAX_ACTIVE_TCP=48
CONFIG_LWIP_TCP_MSL=10000
CONFIG_LWIP_TCP_FIN_WAIT_TIMEOUT=5000

